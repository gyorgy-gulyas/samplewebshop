domain Sales {

    context OrderManagement {

        # A reusable field group: everything that is a sales document carries these, so the fields
        # are declared once and inherited rather than repeated.
        composite SalesDocument {
            humanKey:string
            partnerData:string
        }

        aggregate Order {

            enum OrderStatuses {
                Draft,
                Released,
                Finished,
                Canceled
            }

            valueobject OrderItem {
                productId:string
                productName:string
                quantity:number validate value > 0
                unitPrice:number validate value >= 0
                subTotalPrice:number validate value >= 0
            }

            root entity OrderHeader inherits Core.Base.BaseEntity, SalesDocument {
                # Another aggregate is referenced by identity, never embedded. The .NET emitter turns
                # this into a typed EntityId, so handing over an order id where a customer id belongs
                # stops being a runtime mystery and becomes a compile error.
                customer:ref CustomerManagement.Customers.Customer

                orderingDate:date
                status:OrderStatuses
                totalPrice:number validate value >= 0
                items:list[OrderItem]

                # The root records the fact, because the root is what enforces the invariant that
                # makes it true. It does not publish it: the repository moves it into the outbox
                # with the save, and delivery is the platform's problem from there.
                command place( customerId:string ) emits OrderPlaced
            }

            # The context's PRIVATE language. No version, and that is a statement: the consumers of
            # this fact ship in the same deployment unit and move with it, so breaking its shape is
            # a compile error rather than a wire incident.
            domain event OrderPlaced {
                orderId:string
                customerId:string
                totalPrice:number
            }
        }

        service OrderService {
            query getOrder( orderId:string ) : Order.OrderHeader
            command placeOrder( order:Order.OrderHeader ) : Order.OrderHeader
        }

        # Fulfilling an order is long running and it can fail halfway: the stock is reserved, then
        # the card is charged, then the parcel ships. The model declares WHICH steps exist and what
        # undoes each one - it deliberately does not declare their order, because a set of steps is
        # all a model can honestly say. The developer writes the sequence; the generated step facade
        # records every compensation and rolls them back in reverse when something throws.
        @retry( 3 )
        @timeout( "10m" )
        workflow FulfilOrder {

            @start
            command fulfil( order:ref Order, sku:string, quantity:number, amount:number, shippingAddress:string ) : string

            # No return value, so the caller cannot be answered: this is a signal.
            command cancel( reason:string )

            # A query is read-only and synchronous - it may not await anything.
            query status() : string

            step reserveStock( order:ref Order, sku:string, quantity:number ) : string compensate releaseStock
            step releaseStock( order:ref Order, sku:string, reservationId:string )

            # A card charge is not idempotent, so one attempt only - and the money must not be left
            # in limbo, hence the short deadline. Both are business properties, so both are modelled.
            @retry( 1 )
            @timeout( "30s" )
            step chargeCard( order:ref Order, amount:number ) : string compensate refundCard
            step refundCard( order:ref Order, chargeId:string )

            # Nothing compensates shipping: once the parcel is gone, it is gone. The absence of a
            # compensate is itself the statement.
            step shipOrder( order:ref Order, shippingAddress:string ) : string
        }

        # The published surface of orders: DTOs only, no domain type ever reaches the wire.
        @internal_api(grpc, rest)
        @public_api(grpc, rest, collection="BFF")
        interface OrderIF version 1 {
            # The PUBLISHED restatement of the internal fact. Versioned, because another team reads
            # it; translated by hand, because the published language is not the internal one -
            # customerId stays inside, and the amount is named the way the outside world names it.
            integration event OrderPlaced version 1 from Order.OrderPlaced {
                orderId:string
                totalAmount:number
            }

            enum OrderStatuses {
                Draft,
                Released,
                Finished,
                Canceled
            }

            dto OrderItemDTO {
                enum DeliveryStatuses {
                    NotDelivered,
                    PartiallyDelivered,
                    Delivered
                }

                productId:string
                productName:string
                quantity:number validate value > 0
                unitPrice:number validate value >= 0
                subTotalPrice:number
                deliveryStatus:DeliveryStatuses
            }

            dto OrderDTO {
                dto CustomerDataDTO {
                    customerId:string
                    customerName:string
                }

                @system_field id:string

                orderingDate:string
                orderStatus:OrderStatuses
                totalPrice:number
                customerData:CustomerDataDTO
                items:list[OrderItemDTO]
            }

            query getOrder( orderId:string ) : OrderDTO
            command placeOrder( order:OrderDTO ) : OrderDTO
            command setPrice( orderItem:OrderItemDTO, price:number ) : OrderItemDTO
            command justOrder( orderId:string )
        }

        # The second version lives next to the first on purpose: this is how a published interface is
        # carried forward without breaking the callers still on v1.
        @internal_api(grpc, rest)
        @public_api(grpc, rest, collection="BFF")
        interface OrderIF version 2 {
            event OrderPlaced version 2 {
                orderId:string
                customerId:string
            }

            enum OrderStatuses {
                Draft,
                Released,
                Finished,
                Canceled
            }

            dto OrderItemDTO {
                enum DeliveryStatuses {
                    NotDelivered,
                    PartiallyDelivered,
                    Delivered
                }

                productId:string
                productName:string
                quantity:number validate value > 0
                unitPrice:number validate value >= 0
                subTotalPrice:number
                deliveryStatus:DeliveryStatuses
            }

            dto OrderDTO {
                dto CustomerDataDTO {
                    customerId:string
                    customerName:string
                }

                @system_field id:string

                orderingDate:string
                orderStatus:OrderStatuses
                totalPrice:number
                customerData:CustomerDataDTO
                items:list[OrderItemDTO]

                # v2 addition: where the parcel is going
                @optional
                shippingCity:string
            }

            query getOrder( orderId:string ) : OrderDTO
            command placeOrder( order:OrderDTO ) : OrderDTO
            command justOrder( orderId:string )
        }
    }

    context Tracking {

        # Tracking reacts to what OrderManagement PUBLISHES, never to its internal facts. That is
        # the whole point of the published contract: OrderManagement can rename a private field
        # tomorrow without this context noticing.
        eventhandler onOrderPlaced for integration event OrderManagement.OrderIF.v1.OrderPlaced.v1

        enum TrackingStatuses
        {
            # Order has been placed but not yet processed
            Pending,

            # Order has been confirmed (e.g. payment received)
            Confirmed,

            # Order is being prepared in the warehouse
            Processing,

            # Package is ready and waiting for pickup by courier
            ReadyForPickup,

            # Package has been handed over to the shipping provider
            Shipped,

            # Package is in transit between locations
            InTransit,

            # Package is out for delivery to the customer
            OutForDelivery,

            # Package successfully delivered to the customer
            Delivered,

            # Delivery failed (e.g. customer was not available)
            FailedDelivery,

            # Package returned (by customer or shipping provider)
            Returned,

            # Order was cancelled (e.g. payment failed or user cancelled)
            Cancelled
        }

        aggregate OrderTrackingEntry {

            root entity TrackingEntry inherits Core.Base.BaseEntity {
                order:ref Sales.OrderManagement.Order
                trackingStatus:TrackingStatuses
                statusDate:datetime
            }
        }
    }
}
