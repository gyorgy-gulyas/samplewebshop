<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".\packages\" />
  </config>
  <packageSources>
    <clear />
    <add key="LocalDevFeed" value="./../LocalDevNugetFeed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <!-- The MicronIQ packages come from the local feed, built from the sibling repositories -->
    <packageSource key="LocalDevFeed">
      <package pattern="PolyPersist.*" />
      <package pattern="ServiceKit.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
